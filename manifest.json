{
  "manifest_version": 3,
  "name": "Patreon & Fantia Image Batch Downloader",
  "version": "1.6",
  "description": "Batch extract and download high-resolution images from Patreon and Fantia posts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "patreon-image-downloader@lunmankit.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.patreon.com/*",
    "https://patreon.com/*",
    "https://*.fantia.jp/*",
    "https://fantia.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/default16.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Patreon & Fantia Image Batch Downloader",
    "default_icon": {
      "16": "icons/default16.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  }
}
