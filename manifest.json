{
  "manifest_version": 3,
  "name": "Patreon Image Batch Downloader",
  "version": "1.3",
  "description": "Batch extract and download high-resolution images from Patreon posts.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.patreon.com/*",
    "https://patreon.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/default16.png",
    "48": "icons/default48.png",
    "128": "icons/default128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Patreon Image Batch Downloader",
    "default_icon": {
      "16": "icons/default16.png",
      "48": "icons/default48.png",
      "128": "icons/default128.png"
    }
  }
}
